    <true/>
    <key>StandardOutPath</key>
    <string>/Users/jakubronkiewicz/Library/Logs/TrainLog-redeploy.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jakubronkiewicz/Library/Logs/TrainLog-redeploy.log</string>
</dict>
</plist>
